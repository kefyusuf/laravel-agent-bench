+<?php
+
+namespace App\Models;
+
+use Illuminate\Database\Eloquent\Model;
+
+class IdempotencyKey extends Model
+{
+    protected $fillable = [
+        'key',
+        'customer_id',
+        'status',
+        'response_body',
+    ];
+
+    protected function casts(): array
+    {
+        return [
+            'customer_id' => 'integer',
+            'response_body' => 'array',
+        ];
+    }
+}
